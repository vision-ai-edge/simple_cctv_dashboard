# =============================================================================
# simple_cctv_dashboard — Environment Variables
# Copy this file to .env and fill in the appropriate values for your setup.
# =============================================================================

# 데이터베이스
# SQLite 파일 경로 — 모노레포 환경에서는 절대 경로 사용 권장
# 상대 경로는 각 패키지의 cwd 기준으로 해석되므로 API/migrate/seed 가 서로 다른 파일을 보게 된다
# 예: DATABASE_PATH=/absolute/path/to/project/data/cctv.sqlite
DATABASE_PATH=./data/cctv.sqlite

# API 서버
API_PORT=3000
NODE_ENV=development

# 인증 (SPEC-AUTH-001)
# JWT 서명 키 — 최소 32바이트 이상 필수 (서버 시작 시 검증)
# 생성 예: openssl rand -base64 48
JWT_SECRET=replace-with-openssl-rand-base64-48-output-min-32-bytes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Box 자격증명 암호화 키 (AES-GCM, 32 bytes hex)
# `openssl rand -hex 32` 로 생성
BOX_VAULT_KEY=

# WebPush (SPEC-ALERT에서 사용)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Telegram (SPEC-ALERT에서 사용)
TELEGRAM_BOT_TOKEN=
