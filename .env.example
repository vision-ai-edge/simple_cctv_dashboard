# =============================================================================
# simple_cctv_dashboard — Environment Variables
# Copy this file to .env and fill in the appropriate values for your setup.
# =============================================================================

# 데이터베이스
# SQLite 파일 경로 (상대 경로는 프로젝트 루트 기준)
DATABASE_PATH=./data/cctv.sqlite

# API 서버
API_PORT=3000
NODE_ENV=development

# 인증
# JWT 서명에 사용되는 비밀 키 (프로덕션에서는 반드시 강력한 무작위 값 사용)
JWT_SECRET=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Box 자격증명 암호화 키 (AES-GCM, 32 bytes hex)
# `openssl rand -hex 32` 로 생성
BOX_VAULT_KEY=

# WebPush (SPEC-ALERT에서 사용)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Telegram (SPEC-ALERT에서 사용)
TELEGRAM_BOT_TOKEN=
