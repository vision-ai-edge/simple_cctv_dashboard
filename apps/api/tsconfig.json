{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "paths": {
      "@cctv/shared": ["../../packages/shared/src/index.ts"],
      "@cctv/db": ["../../packages/db/src/index.ts"],
      "@cctv/db/schema": ["../../packages/db/src/schema.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"],
  "references": [{ "path": "../../packages/shared" }, { "path": "../../packages/db" }]
}
