{
  "name": "@cctv/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "import": "./src/schema.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "migrate": "bun run src/migrate.ts",
    "seed": "bun run src/seed.ts",
    "test": "bun test src/",
    "test:cov": "bun test src/ --coverage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.36.4",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/bun": "^1.2.0",
    "drizzle-kit": "^0.28.1",
    "typescript": "^5.9.0"
  }
}
